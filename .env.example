MEDASSIST_SERVICE_NAME=medassist-ai
MEDASSIST_LLM_PROVIDER=openai
# Leave blank for Checkpoint 1. Select a model before implementing inference.
MEDASSIST_LLM_MODEL=
# Optional; never commit a real key. No LLM calls exist in this checkpoint.
MEDASSIST_LLM_API_KEY=
MEDASSIST_LLM_MAX_OUTPUT_TOKENS=1024
MEDASSIST_PUBMED_RESULT_LIMIT=10
# Per-request external HTTP timeout, in seconds (used in future checkpoints).
MEDASSIST_REQUEST_TIMEOUT_SECONDS=30
